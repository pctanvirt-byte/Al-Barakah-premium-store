rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is a Super Admin
    function isSuperAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'albarakahpremium10@gmail.com' ||
        request.auth.token.email == 'pctanvirt@gmail.com'
      );
    }

    // 1. Products: Public read, allow write for store administration
    match /products/{productId} {
      allow read: if true;
      allow write, delete: if true;
    }

    // 1. Categories: Public read, allow write/delete for store administration
    match /categories/{categoryId} {
      allow read: if true;
      allow write, delete: if true;
    }

    // 2. Orders:
    // - Public & Admin can read/list/create orders
    // - Admin can update status or permanently delete orders
    match /orders/{orderId} {
      allow read, write, delete: if true;
    }

    // Reviews: Public read & create verified review, allow delete/moderate
    match /reviews/{reviewId} {
      allow read, write, delete: if true;
    }

    // 3. Store Settings (Banners, bKash numbers, Pixel & Domain configs):
    match /settings/{settingId} {
      allow read, write: if true;
    }
  }
}
