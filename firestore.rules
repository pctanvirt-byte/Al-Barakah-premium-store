rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'albarakahpremium10@gmail.com' ||
        request.auth.token.email == 'pctanvirt@gmail.com'
      );
    }

    // 1. Products: Public read, only authenticated staff/admin can create, update, or delete
    match /products/{productId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // 2. Categories: Public read, only authenticated staff/admin can modify
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // 3. Orders:
    // - Customers can create orders and read for tracking
    // - Only authenticated admins can update status or delete orders
    match /orders/{orderId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAuthenticated();
    }

    // 4. Reviews:
    // - Public read & public verified review creation
    // - Only authenticated admins can update or delete reviews
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAuthenticated();
    }

    // 5. Store Settings (Banners, bKash numbers, Pixel & Courier configs):
    // - Public read for frontend rendering
    // - Only authenticated staff/admin can write
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // 6. User Profiles / Staff:
    match /users/{userId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
  }
}

