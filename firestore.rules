rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'albarakahpremium10@gmail.com' ||
        request.auth.token.email == 'pctanvirt@gmail.com'
      );
    }

    // 1. Products: Public read and write for seamless store & admin management
    match /products/{productId} {
      allow read, write: if true;
    }

    // 2. Categories: Public read and write
    match /categories/{categoryId} {
      allow read, write: if true;
    }

    // 3. Orders: Public read and write
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // 4. Reviews: Public read and write
    match /reviews/{reviewId} {
      allow read, write: if true;
    }

    // 5. Store Settings: Public read and write
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // 6. User Profiles / Staff: Public read and write
    match /users/{userId} {
      allow read, write: if true;
    }
  }
}

